[Unit]
Description=tack

[Service]
# The default working directory for new conversations, if it exists.
WorkingDirectory=-%h/tack
ExecStart=%h/.local/bin/tack
Restart=on-failure
RestartSec=2
# 70 is the secret tripwire. It has to stay down until someone looks.
RestartPreventExitStatus=70 78
NoNewPrivileges=true

[Install]
WantedBy=default.target
